    const LETTERS = ['A', 'B', 'C', 'D', 'E'];
    const STORAGE_KEY = 'shui_portal_v3';

    // =========================================================================
    // 4. APPLICATION STATE
    // =========================================================================
    let userState = loadUserState();

    const appState = {
      activePage: 'home', // 'home' | 'quiz' | 'exam' | 'notes' | 'flashcards' | 'mistakes'
      quizFilter: 'Tümü',
      quizMistakesOnly: false,
      quizList: [],
      quizIdx: 0,
      quizAnswers: {},
      quizFinished: false,

      fcFilter: 'Tümü',
      fcList: [],
      fcIdx: 0,
      fcFlipped: false,

      notesFilter: 'Tümü',
      notesSearch: '',

      examScope: 'Tümü',
      examStatus: 'lobby', // 'lobby' | 'running' | 'report'
      examQuestions: [],
      examAnswers: {},
      examFlags: {},
      examIdx: 0,
      examSecondsLeft: 25 * 60,
      examElapsedSeconds: 0,
      examTimerId: null,
    };

    function defaultExamDate() {
      const d = new Date();
      d.setDate(d.getDate() + 14);
      return d.toISOString().split('T')[0];
    }

    function loadUserState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          return {
            theme: p.theme || 'dark',
            solved: p.solved || {},
            mistakes: Array.isArray(p.mistakes) ? p.mistakes : [],
            streak: typeof p.streak === 'number' ? p.streak : 0,
            examDate: p.examDate || defaultExamDate(),
          };
        }
      } catch (e) {
        console.warn('Kayıt okunamadı:', e);
      }
      return {
        theme: 'dark',
        solved: {},
        mistakes: [],
        streak: 0,
        examDate: defaultExamDate(),
      };
    }

    function saveUserState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(userState));
      } catch (e) {
        console.warn('Kayıt yazılamadı:', e);
      }
    }

    // =========================================================================
    // 5. CORE HELPERS
    // =========================================================================
    function applyTheme(theme) {
      document.documentElement.classList.toggle('dark', theme === 'dark');
    }

    function toggleTheme() {
      userState.theme = userState.theme === 'dark' ? 'light' : 'dark';
      applyTheme(userState.theme);
      saveUserState();
      showToast(userState.theme === 'dark' ? 'Koyu havacılık teması aktif.' : 'Aydınlık tema aktif.');
    }

    function filterQuestions(course) {
      if (!course || course === 'Tümü') return [...QUESTIONS];
      return QUESTIONS.filter((q) => q.course === course);
    }

    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function addMistake(id) {
      if (!userState.mistakes.includes(id)) {
        userState.mistakes.push(id);
        saveUserState();
      }
    }

    function removeMistake(id) {
      const idx = userState.mistakes.indexOf(id);
      if (idx !== -1) {
        userState.mistakes.splice(idx, 1);
        saveUserState();
        return true;
      }
      return false;
    }

    let toastTimer = null;
    function showToast(msg) {
      const el = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = msg;
      el.classList.remove('hidden');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.add('hidden'), 2700);
    }

    function downloadPortalHTML() {
      try {
        const docHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
        const blob = new Blob([docHtml], { type: 'text/html;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'index.html';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast('index.html indirildi! GitHub deponuza yükleyebilirsiniz.');
      } catch (err) {
        showToast('Dosya indirilirken bir hata oluştu.');
      }
    }

    // =========================================================================
    // 6. NAVIGATION & HEADER
    // =========================================================================
    function navigateTo(page) {
      appState.activePage = page;
      const pages = ['home', 'quiz', 'exam', 'notes', 'flashcards', 'mistakes'];
      pages.forEach((p) => {
        document.getElementById(`page-${p}`).classList.toggle('hidden', p !== page);
      });

      document.querySelectorAll('.nav-link').forEach((btn) => {
        const isCurrent = btn.dataset.nav === page;
        if (isCurrent) {
          btn.className =
            'nav-link shrink-0 px-3.5 py-2 rounded-xl text-xs font-extrabold transition-all cursor-pointer bg-gradient-to-r from-sky-500 to-indigo-600 text-white shadow-sm inline-flex items-center gap-1.5';
        } else {
          btn.className =
            'nav-link shrink-0 px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer text-slate-600 dark:text-slate-400 hover:bg-slate-200/70 dark:hover:bg-slatebg-800 hover:text-slate-900 dark:hover:text-white inline-flex items-center gap-1.5';
        }
      });

      renderHeader();
      if (page === 'home') renderHome();
      if (page === 'quiz') renderQuiz();
      if (page === 'exam') renderExamView();
      if (page === 'notes') renderNotes();
      if (page === 'flashcards') renderFlashcards();
      if (page === 'mistakes') renderMistakes();

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderHeader() {
      document.getElementById('header-streak').textContent = userState.streak;
      document.getElementById('nav-mistakes-badge').textContent = userState.mistakes.length;
      document.getElementById('nav-mistakes-badge-mobile').textContent = userState.mistakes.length;
    }

    // =========================================================================
    // 7. HOME PAGE & EXAM COUNTDOWN
    // =========================================================================
    function updateCountdown() {
      const targetStr = userState.examDate;
      const daysEl = document.getElementById('cd-days');
      const hoursEl = document.getElementById('cd-hours');
      const minsEl = document.getElementById('cd-mins');
      const statusEl = document.getElementById('cd-status-text');

      if (!targetStr) {
        daysEl.textContent = '--';
        hoursEl.textContent = '--';
        minsEl.textContent = '--';
        return;
      }

      const target = new Date(`${targetStr}T09:00:00`);
      const now = new Date();
      const diff = target.getTime() - now.getTime();

      if (diff <= 0) {
        daysEl.textContent = '0';
        hoursEl.textContent = '0';
        minsEl.textContent = '0';
        statusEl.textContent = 'Sınav günü geldi! Başarılar dileriz.';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const mins = Math.floor((diff / (1000 * 60)) % 60);

      daysEl.textContent = days;
      hoursEl.textContent = String(hours).padStart(2, '0');
      minsEl.textContent = String(mins).padStart(2, '0');
      statusEl.textContent = `Sınava ${days} gün ${hours} saat kaldı. Planlı çalışmaya devam!`;
    }

    function renderHome() {
      const solvedIds = Object.keys(userState.solved);
      const solvedCount = solvedIds.length;
      const correctCount = solvedIds.filter((id) => userState.solved[id] === 'correct').length;
      const accuracy = solvedCount > 0 ? Math.round((correctCount / solvedCount) * 100) : 0;

      document.getElementById('home-stat-solved').textContent = `${solvedCount} / ${QUESTIONS.length}`;
      document.getElementById('home-stat-accuracy').textContent = `%${accuracy}`;
      document.getElementById('home-stat-mistakes').textContent = userState.mistakes.length;

      const dateInput = document.getElementById('exam-date-input');
      dateInput.value = userState.examDate;
      updateCountdown();

      const grid = document.getElementById('home-course-cards');
      grid.innerHTML = '';

      COURSE_KEYS.forEach((courseName) => {
        const meta = COURSES[courseName];
        const qs = filterQuestions(courseName);
        const mastered = qs.filter((q) => userState.solved[q.id] === 'correct').length;
        const pct = qs.length > 0 ? Math.round((mastered / qs.length) * 100) : 0;

        const card = document.createElement('div');
        card.className =
          'glass-panel bg-white/85 dark:bg-slatebg-850/85 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-md flex flex-col justify-between gap-5 hover:shadow-xl transition-all';

        card.innerHTML = `
          <div class="space-y-4">
            <div class="flex items-start justify-between gap-3">
              <div class="w-12 h-12 rounded-2xl ${meta.iconBg} flex items-center justify-center shrink-0">
                ${meta.icon}
              </div>
              <span class="text-xs font-extrabold px-3 py-1 rounded-full ${meta.badgeClass}">
                ${qs.length} Soru
              </span>
            </div>

            <div class="space-y-1.5">
              <h3 class="font-display text-lg font-extrabold text-slate-900 dark:text-white">
                ${meta.name}
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                ${meta.desc}
              </p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-xs font-bold">
                <span class="text-slate-500 dark:text-slate-400">Hakimiyet Oranı</span>
                <span class="text-slate-900 dark:text-white">%${pct} (${mastered}/${qs.length})</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-slate-200/80 dark:bg-slatebg-950 overflow-hidden">
                <div class="h-full rounded-full bg-gradient-to-r ${meta.barClass} transition-all duration-500" style="width: ${pct}%"></div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                data-action="quiz"
                data-course="${courseName}"
                class="course-card-btn py-2.5 px-3 rounded-xl text-xs font-extrabold shadow-md transition-all cursor-pointer ${meta.btnClass}"
              >
                Test Başlat
              </button>
              <button
                type="button"
                data-action="notes"
                data-course="${courseName}"
                class="course-card-btn py-2.5 px-3 rounded-xl text-xs font-extrabold transition-all cursor-pointer ${meta.softBtnClass}"
              >
                Konu Özeti
              </button>
            </div>
          </div>
        `;

        grid.appendChild(card);
      });

      grid.querySelectorAll('.course-card-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.action;
          const course = btn.dataset.course;
          if (action === 'quiz') {
            appState.quizFilter = course;
            appState.quizMistakesOnly = false;
            initQuiz(false, false);
            navigateTo('quiz');
          } else if (action === 'notes') {
            appState.notesFilter = course;
            navigateTo('notes');
          }
        });
      });
    }

    // =========================================================================
    // 8. QUIZ MODE (TEST ÇÖZ)
    // =========================================================================
    function initQuiz(mistakesOnly = false, autoShuffle = false) {
      appState.quizMistakesOnly = mistakesOnly;
      let list = filterQuestions(appState.quizFilter);
      if (mistakesOnly) {
        list = list.filter((q) => userState.mistakes.includes(q.id));
      }
      appState.quizList = autoShuffle ? shuffle(list) : list;
      appState.quizIdx = 0;
      appState.quizAnswers = {};
      appState.quizFinished = false;
    }

    function renderQuizFilterPills() {
      const container = document.getElementById('quiz-course-filters');
      container.innerHTML = '';
      const items = ['Tümü', ...COURSE_KEYS];

      items.forEach((item) => {
        const count = item === 'Tümü' ? QUESTIONS.length : filterQuestions(item).length;
        const active = appState.quizFilter === item && !appState.quizMistakesOnly;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = active
          ? 'px-3.5 py-2 rounded-xl text-xs font-extrabold bg-sky-600 text-white shadow-sm cursor-pointer'
          : 'px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer';
        btn.textContent = `${item} (${count})`;
        btn.addEventListener('click', () => {
          appState.quizFilter = item;
          initQuiz(false, item === 'Tümü');
          renderQuiz();
        });
        container.appendChild(btn);
      });
    }

    function renderQuiz() {
      renderQuizFilterPills();

      const cardEl = document.getElementById('quiz-card');
      const summaryEl = document.getElementById('quiz-summary');
      const modeLabel = document.getElementById('quiz-mode-label');

      if (appState.quizMistakesOnly) {
        modeLabel.textContent = 'Yanlışlarım Mini Testi';
        modeLabel.className = 'text-xs font-extrabold text-rose-500';
      } else {
        modeLabel.textContent = `${appState.quizFilter} — Alıştırma Testi`;
        modeLabel.className = 'text-xs font-extrabold text-sky-600 dark:text-sky-400';
      }

      if (appState.quizList.length === 0) {
        cardEl.classList.add('hidden');
        summaryEl.classList.remove('hidden');
        document.getElementById('quiz-counter').textContent = '0 / 0';
        document.getElementById('quiz-progress-fill').style.width = '100%';
        document.getElementById('summary-desc').textContent = 'Bu filtrede çözülecek soru bulunmuyor.';
        document.getElementById('summary-correct').textContent = '0';
        document.getElementById('summary-wrong').textContent = '0';
        document.getElementById('summary-rate').textContent = '%100';
        return;
      }

      if (appState.quizFinished) {
        cardEl.classList.add('hidden');
        summaryEl.classList.remove('hidden');
        const total = appState.quizList.length;
        let correct = 0;
        let wrong = 0;
        appState.quizList.forEach((q) => {
          const ans = appState.quizAnswers[q.id];
          if (ans === q.correct) correct++;
          else if (ans !== undefined) wrong++;
        });
        const rate = total > 0 ? Math.round((correct / total) * 100) : 0;
        document.getElementById('quiz-counter').textContent = `Tamamlandı (${total}/${total})`;
        document.getElementById('quiz-progress-fill').style.width = '100%';
        document.getElementById('summary-desc').textContent = `Toplam ${total} soruluk test oturumu tamamlandı.`;
        document.getElementById('summary-correct').textContent = correct;
        document.getElementById('summary-wrong').textContent = wrong;
        document.getElementById('summary-rate').textContent = `%${rate}`;
        return;
      }

      cardEl.classList.remove('hidden');
      summaryEl.classList.add('hidden');

      const q = appState.quizList[appState.quizIdx];
      const total = appState.quizList.length;
      const picked = appState.quizAnswers[q.id];
      const answered = picked !== undefined;
      const cMeta = COURSES[q.course];

      document.getElementById('quiz-counter').textContent = `Soru ${appState.quizIdx + 1} / ${total}`;
      const pct = Math.round(((appState.quizIdx + (answered ? 1 : 0)) / total) * 100);
      document.getElementById('quiz-progress-fill').style.width = `${pct}%`;

      const cTag = document.getElementById('quiz-course-tag');
      cTag.textContent = q.course;
      cTag.className = `text-xs font-extrabold px-3 py-1 rounded-full ${cMeta.badgeClass}`;
      document.getElementById('quiz-source-tag').textContent = q.source;

      const isStarred = userState.mistakes.includes(q.id);
      const starBtn = document.getElementById('btn-star-question');
      starBtn.className = isStarred
        ? 'inline-flex items-center gap-1.5 text-xs font-extrabold px-3 py-1.5 rounded-xl border border-amber-500/35 bg-amber-500/15 text-amber-600 dark:text-amber-300 cursor-pointer'
        : 'inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 cursor-pointer';
      starBtn.textContent = isStarred ? '★ Zorlandıklarımda' : '☆ Yıldızla';

      document.getElementById('quiz-question-text').textContent = q.q;

      const optList = document.getElementById('quiz-options-list');
      optList.innerHTML = '';

      q.options.forEach((optText, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.disabled = answered;

        let cardCls =
          'bg-slate-50/80 dark:bg-slatebg-900/70 border-slate-200/90 dark:border-slate-800 hover:border-sky-500/60 hover:bg-sky-500/5 text-slate-800 dark:text-slate-100 cursor-pointer';
        let letterCls =
          'bg-white dark:bg-slatebg-800 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-700';

        if (answered) {
          if (idx === q.correct) {
            cardCls = 'bg-emerald-500/15 border-emerald-500 text-emerald-950 dark:text-emerald-100 animate-pop';
            letterCls = 'bg-emerald-500 text-white border-emerald-500';
          } else if (idx === picked && idx !== q.correct) {
            cardCls = 'bg-rose-500/15 border-rose-500 text-rose-950 dark:text-rose-100 animate-shake';
            letterCls = 'bg-rose-500 text-white border-rose-500';
          } else {
            cardCls =
              'bg-slate-100/40 dark:bg-slatebg-900/30 border-slate-200/50 dark:border-slate-800/50 text-slate-400 dark:text-slate-500';
            letterCls =
              'bg-slate-100 dark:bg-slatebg-800/50 text-slate-400 dark:text-slate-500 border-slate-200/60 dark:border-slate-800';
          }
        }

        btn.className = `w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-start gap-3.5 ${cardCls}`;
        btn.innerHTML = `
          <span class="shrink-0 w-7 h-7 rounded-lg border text-xs font-extrabold flex items-center justify-center mt-0.5 ${letterCls}">
            ${LETTERS[idx]}
          </span>
          <span class="text-sm sm:text-base font-medium leading-snug flex-1">${optText}</span>
        `;
        btn.addEventListener('click', () => handleQuizAnswer(idx));
        optList.appendChild(btn);
      });

      const fbBox = document.getElementById('quiz-feedback-box');
      if (answered) {
        const isRight = picked === q.correct;
        fbBox.classList.remove('hidden');
        if (isRight) {
          fbBox.className = 'rounded-2xl p-4 sm:p-5 border bg-emerald-500/10 border-emerald-500/30 animate-fade-in';
          document.getElementById('quiz-feedback-icon').innerHTML =
            `<div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-500 flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></div>`;
          document.getElementById('quiz-feedback-title').className = 'text-sm font-extrabold text-emerald-600 dark:text-emerald-400';
          document.getElementById('quiz-feedback-title').textContent = 'Doğru Cevap!';
        } else {
          fbBox.className = 'rounded-2xl p-4 sm:p-5 border bg-rose-500/10 border-rose-500/30 animate-fade-in';
          document.getElementById('quiz-feedback-icon').innerHTML =
            `<div class="w-6 h-6 rounded-full bg-rose-500/20 text-rose-500 flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></div>`;
          document.getElementById('quiz-feedback-title').className = 'text-sm font-extrabold text-rose-600 dark:text-rose-400';
          document.getElementById('quiz-feedback-title').textContent = `Yanlış Cevap — Doğru Şık: ${LETTERS[q.correct]}`;
        }
        document.getElementById('quiz-feedback-hint').textContent = q.hint;
      } else {
        fbBox.classList.add('hidden');
      }

      document.getElementById('btn-quiz-prev').disabled = appState.quizIdx === 0;
      document.getElementById('btn-quiz-next-text').textContent =
        appState.quizIdx === total - 1 ? 'Testi Bitir' : 'Sonraki Soru';
    }

    function handleQuizAnswer(optIdx) {
      const q = appState.quizList[appState.quizIdx];
      if (!q || appState.quizAnswers[q.id] !== undefined) return;

      appState.quizAnswers[q.id] = optIdx;
      const isRight = optIdx === q.correct;

      if (isRight) {
        userState.solved[q.id] = 'correct';
        userState.streak += 1;
        if (removeMistake(q.id)) {
          showToast('Doğru! Soru Yanlışlarım listesinden düşürüldü.');
        }
      } else {
        userState.solved[q.id] = 'wrong';
        userState.streak = 0;
        addMistake(q.id);
      }

      saveUserState();
      renderHeader();
      renderQuiz();
    }

    // =========================================================================
    // 9. EXAM SIMULATION (20 QUESTIONS / 25 MINUTES)
    // =========================================================================
    function renderExamLobby() {
      const container = document.getElementById('exam-scope-options');
      container.innerHTML = '';
      const scopes = [
        { key: 'Tümü', label: 'Karma Deneme Sınavı (3 Ders)', sub: 'Havacılık Hukuku + MİY + Lojistik' },
        { key: 'Havacılık Hukuku', label: 'Havacılık Hukuku Sınavı', sub: '20 Soruluk Branş Denemesi' },
        { key: 'Müşteri İlişkileri Yönetimi', label: 'Müşteri İlişkileri Yönetimi Sınavı', sub: '20 Soruluk Branş Denemesi' },
        { key: 'Lojistik Yönetimi', label: 'Lojistik Yönetimi Sınavı', sub: '20 Soruluk Branş Denemesi' },
      ];

      scopes.forEach((sc) => {
        const active = appState.examScope === sc.key;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = active
          ? 'text-left p-4 rounded-2xl border-2 border-amber-500 bg-amber-500/10 transition-all cursor-pointer'
          : 'text-left p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slatebg-900/70 hover:border-amber-500/40 transition-all cursor-pointer';
        btn.innerHTML = `
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white">${sc.label}</div>
          <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">${sc.sub}</div>
        `;
        btn.addEventListener('click', () => {
          appState.examScope = sc.key;
          renderExamLobby();
        });
        container.appendChild(btn);
      });
    }

    function startExamSimulation() {
      if (appState.examTimerId) clearInterval(appState.examTimerId);

      const pool = filterQuestions(appState.examScope);
      appState.examQuestions = shuffle(pool).slice(0, 20);
      appState.examAnswers = {};
      appState.examFlags = {};
      appState.examIdx = 0;
      appState.examSecondsLeft = 25 * 60;
      appState.examElapsedSeconds = 0;
      appState.examStatus = 'running';

      appState.examTimerId = setInterval(() => {
        appState.examSecondsLeft--;
        appState.examElapsedSeconds++;
        updateExamTimerUI();
        if (appState.examSecondsLeft <= 0) {
          finishExamSimulation(true);
        }
      }, 1000);

      renderExamView();
    }

    function updateExamTimerUI() {
      const m = Math.floor(Math.max(0, appState.examSecondsLeft) / 60);
      const s = Math.max(0, appState.examSecondsLeft) % 60;
      const el = document.getElementById('exam-timer-display');
      el.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      if (appState.examSecondsLeft <= 180) {
        el.className = 'font-display text-2xl font-extrabold text-rose-500 tracking-wider mt-0.5 animate-pulse';
      } else {
        el.className = 'font-display text-2xl font-extrabold text-amber-500 tracking-wider mt-0.5';
      }
    }

    function finishExamSimulation(isTimeout = false) {
      if (appState.examTimerId) {
        clearInterval(appState.examTimerId);
        appState.examTimerId = null;
      }
      appState.examStatus = 'report';
      if (isTimeout) showToast('Süre doldu! Sınav otomatik olarak değerlendirildi.');

      // Sync answers with user progress & mistakes list
      appState.examQuestions.forEach((q, idx) => {
        const picked = appState.examAnswers[idx];
        if (picked !== undefined) {
          if (picked === q.correct) {
            userState.solved[q.id] = 'correct';
            removeMistake(q.id);
          } else {
            userState.solved[q.id] = 'wrong';
            addMistake(q.id);
          }
        }
      });
      saveUserState();
      renderHeader();
      renderExamView();
    }

    function renderExamRunner() {
      updateExamTimerUI();
      const total = appState.examQuestions.length;
      const idx = appState.examIdx;
      const q = appState.examQuestions[idx];
      const cMeta = COURSES[q.course];
      const picked = appState.examAnswers[idx];
      const flagged = !!appState.examFlags[idx];

      document.getElementById('exam-q-num').textContent = `Soru ${idx + 1} / ${total}`;
      const cTag = document.getElementById('exam-q-course');
      cTag.textContent = q.course;
      cTag.className = `text-xs font-extrabold px-3 py-1 rounded-full ${cMeta.badgeClass}`;

      const flagBtn = document.getElementById('btn-exam-flag');
      flagBtn.className = flagged
        ? 'inline-flex items-center gap-1.5 text-xs font-extrabold px-3 py-1.5 rounded-xl border border-amber-500/40 bg-amber-500/15 text-amber-500 cursor-pointer'
        : 'inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 cursor-pointer';
      flagBtn.textContent = flagged ? '⚑ İşaretli Soru' : '⚐ Gözden Geçir';

      document.getElementById('exam-q-text').textContent = q.q;

      const optList = document.getElementById('exam-options-list');
      optList.innerHTML = '';

      q.options.forEach((optText, optIdx) => {
        const selected = picked === optIdx;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = selected
          ? 'w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 border-sky-500 bg-sky-500/15 text-slate-900 dark:text-white transition-all flex items-start gap-3.5 cursor-pointer'
          : 'w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 border-slate-200/90 dark:border-slate-800 bg-slate-50/80 dark:bg-slatebg-900/70 hover:border-sky-500/50 text-slate-800 dark:text-slate-100 transition-all flex items-start gap-3.5 cursor-pointer';

        const letterCls = selected
          ? 'bg-sky-500 text-white border-sky-500'
          : 'bg-white dark:bg-slatebg-800 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-700';

        btn.innerHTML = `
          <span class="shrink-0 w-7 h-7 rounded-lg border text-xs font-extrabold flex items-center justify-center mt-0.5 ${letterCls}">
            ${LETTERS[optIdx]}
          </span>
          <span class="text-sm sm:text-base font-medium leading-snug flex-1">${optText}</span>
        `;
        btn.addEventListener('click', () => {
          appState.examAnswers[idx] = optIdx;
          renderExamRunner();
        });
        optList.appendChild(btn);
      });

      document.getElementById('btn-exam-prev').disabled = idx === 0;
      document.getElementById('btn-exam-next').textContent = idx === total - 1 ? 'İlk Soruya Dön' : 'Sonraki →';

      // Palette & counts
      const answeredCount = Object.keys(appState.examAnswers).length;
      document.getElementById('exam-answered-count').textContent = answeredCount;
      document.getElementById('exam-blank-count').textContent = total - answeredCount;

      const palette = document.getElementById('exam-palette-grid');
      palette.innerHTML = '';

      for (let i = 0; i < total; i++) {
        const pBtn = document.createElement('button');
        pBtn.type = 'button';
        const isCurr = i === idx;
        const isAns = appState.examAnswers[i] !== undefined;
        const isFlag = !!appState.examFlags[i];

        let cls =
          'h-9 rounded-xl text-xs font-extrabold border transition-all cursor-pointer flex items-center justify-center ';
        if (isFlag) {
          cls += 'bg-amber-500 text-white border-amber-500';
        } else if (isAns) {
          cls += 'bg-sky-600 text-white border-sky-600';
        } else {
          cls +=
            'bg-slate-100 dark:bg-slatebg-900 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-800 hover:border-sky-500/50';
        }
        if (isCurr) cls += ' ring-2 ring-offset-2 ring-offset-white dark:ring-offset-slatebg-850 ring-indigo-500';

        pBtn.className = cls;
        pBtn.textContent = i + 1;
        pBtn.addEventListener('click', () => {
          appState.examIdx = i;
          renderExamRunner();
        });
        palette.appendChild(pBtn);
      }
    }

    function renderExamReport() {
      const qs = appState.examQuestions;
      const total = qs.length;
      let correct = 0;
      let wrong = 0;
      let blank = 0;

      const byCourse = {};
      COURSE_KEYS.forEach((k) => {
        byCourse[k] = { total: 0, correct: 0 };
      });

      qs.forEach((q, idx) => {
        byCourse[q.course].total++;
        const picked = appState.examAnswers[idx];
        if (picked === undefined) {
          blank++;
        } else if (picked === q.correct) {
          correct++;
          byCourse[q.course].correct++;
        } else {
          wrong++;
        }
      });

      const score = total > 0 ? Math.round((correct / total) * 100) : 0;
      const mins = Math.floor(appState.examElapsedSeconds / 60);
      const secs = appState.examElapsedSeconds % 60;

      document.getElementById('report-score').textContent = score;
      document.getElementById('report-correct').textContent = correct;
      document.getElementById('report-wrong').textContent = wrong;
      document.getElementById('report-blank').textContent = blank;
      document.getElementById('report-time').textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      document.getElementById('report-meta-text').textContent =
        `${appState.examScope} kapsamındaki 20 soruluk sınav simülasyonu değerlendirildi.`;

      const breakdownEl = document.getElementById('report-course-breakdown');
      breakdownEl.innerHTML = '';

      COURSE_KEYS.forEach((cName) => {
        const stat = byCourse[cName];
        if (stat.total === 0) return;
        const meta = COURSES[cName];
        const pct = Math.round((stat.correct / stat.total) * 100);
        const box = document.createElement('div');
        box.className =
          'p-4 rounded-2xl bg-slate-100/80 dark:bg-slatebg-900 border border-slate-200/70 dark:border-slate-800 space-y-2';
        box.innerHTML = `
          <div class="flex items-center justify-between text-xs font-extrabold">
            <span class="text-slate-800 dark:text-slate-200">${meta.short}</span>
            <span class="text-sky-500">${stat.correct}/${stat.total} (%${pct})</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-200 dark:bg-slatebg-950 overflow-hidden">
            <div class="h-full rounded-full bg-gradient-to-r ${meta.barClass}" style="width: ${pct}%"></div>
          </div>
        `;
        breakdownEl.appendChild(box);
      });

      const reviewEl = document.getElementById('report-questions-review');
      reviewEl.innerHTML = '';

      qs.forEach((q, idx) => {
        const picked = appState.examAnswers[idx];
        const isCorrect = picked === q.correct;
        const isBlank = picked === undefined;
        const cMeta = COURSES[q.course];

        let statusBadge = '';
        if (isBlank) {
          statusBadge = '<span class="text-xs font-extrabold px-2.5 py-0.5 rounded-lg bg-amber-500/15 text-amber-500">Boş Bırakıldı</span>';
        } else if (isCorrect) {
          statusBadge = '<span class="text-xs font-extrabold px-2.5 py-0.5 rounded-lg bg-emerald-500/15 text-emerald-500">Doğru</span>';
        } else {
          statusBadge = '<span class="text-xs font-extrabold px-2.5 py-0.5 rounded-lg bg-rose-500/15 text-rose-500">Yanlış</span>';
        }

        const item = document.createElement('div');
        item.className =
          'glass-panel bg-white/85 dark:bg-slatebg-850/85 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 space-y-3';
        item.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-extrabold text-slate-500">Soru #${idx + 1}</span>
              <span class="text-xs font-extrabold px-2.5 py-0.5 rounded-full ${cMeta.badgeClass}">${q.course}</span>
            </div>
            ${statusBadge}
          </div>
          <p class="font-display text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-relaxed">${q.q}</p>
          <div class="text-xs space-y-1">
            ${
              !isBlank && !isCorrect
                ? `<p class="font-bold text-rose-500">Senin Cevabın: ${LETTERS[picked]}) ${q.options[picked]}</p>`
                : ''
            }
            <p class="font-extrabold text-emerald-600 dark:text-emerald-400">Doğru Cevap: ${LETTERS[q.correct]}) ${q.options[q.correct]}</p>
            <p class="text-slate-500 dark:text-slate-400 pt-1">${q.hint}</p>
          </div>
        `;
        reviewEl.appendChild(item);
      });
    }

    function renderExamView() {
      document.getElementById('exam-lobby').classList.toggle('hidden', appState.examStatus !== 'lobby');
      document.getElementById('exam-runner').classList.toggle('hidden', appState.examStatus !== 'running');
      document.getElementById('exam-report').classList.toggle('hidden', appState.examStatus !== 'report');

      if (appState.examStatus === 'lobby') renderExamLobby();
      if (appState.examStatus === 'running') renderExamRunner();
      if (appState.examStatus === 'report') renderExamReport();
    }

    // =========================================================================
    // 10. KONU ÖZETLERİ (STUDY NOTES)
    // =========================================================================
    function renderNotes() {
      const filtersEl = document.getElementById('notes-course-filters');
      filtersEl.innerHTML = '';
      const tabs = ['Tümü', ...COURSE_KEYS];

      tabs.forEach((tab) => {
        const active = appState.notesFilter === tab;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = active
          ? 'px-3.5 py-2 rounded-xl text-xs font-extrabold bg-indigo-600 text-white shadow-sm cursor-pointer'
          : 'px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer';
        btn.textContent = tab;
        btn.addEventListener('click', () => {
          appState.notesFilter = tab;
          renderNotes();
        });
        filtersEl.appendChild(btn);
      });

      const query = appState.notesSearch.trim().toLowerCase();
      const filtered = STUDY_NOTES.filter((note) => {
        const matchCourse = appState.notesFilter === 'Tümü' || note.course === appState.notesFilter;
        if (!matchCourse) return false;
        if (!query) return true;
        const blob = `${note.course} ${note.tag} ${note.title} ${note.points.join(' ')}`.toLowerCase();
        return blob.includes(query);
      });

      const grid = document.getElementById('notes-grid');
      grid.innerHTML = '';

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="md:col-span-2 glass-panel bg-white/85 dark:bg-slatebg-850/85 rounded-2xl p-8 border border-slate-200/80 dark:border-slate-800 text-center text-sm text-slate-500">
            Aramanızla eşleşen konu özeti bulunamadı.
          </div>
        `;
        return;
      }

      filtered.forEach((note) => {
        const cMeta = COURSES[note.course];
        const card = document.createElement('article');
        card.className =
          'glass-panel bg-white/85 dark:bg-slatebg-850/85 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4';

        card.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-extrabold px-3 py-1 rounded-full ${cMeta.badgeClass}">
              ${note.course}
            </span>
            <span class="text-[11px] font-bold text-slate-400">
              ${note.tag}
            </span>
          </div>
          <h3 class="font-display text-base sm:text-lg font-extrabold text-slate-900 dark:text-white">
            ${note.title}
          </h3>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            ${note.points
              .map(
                (pt) => `
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-500 mt-2 shrink-0"></span>
                <span>${pt}</span>
              </li>
            `
              )
              .join('')}
          </ul>
        `;
        grid.appendChild(card);
      });
    }

    // =========================================================================
    // 11. 3D FLASHCARDS
    // =========================================================================
    function initFlashcards(autoShuffle = false) {
      const list = filterQuestions(appState.fcFilter);
      appState.fcList = autoShuffle ? shuffle(list) : list;
      appState.fcIdx = 0;
      appState.fcFlipped = false;
    }

    function renderFlashcards() {
      const filtersEl = document.getElementById('fc-course-filters');
      filtersEl.innerHTML = '';
      ['Tümü', ...COURSE_KEYS].forEach((tab) => {
        const active = appState.fcFilter === tab;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = active
          ? 'px-3.5 py-2 rounded-xl text-xs font-extrabold bg-sky-600 text-white shadow-sm cursor-pointer'
          : 'px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer';
        btn.textContent = tab;
        btn.addEventListener('click', () => {
          appState.fcFilter = tab;
          initFlashcards(false);
          renderFlashcards();
        });
        filtersEl.appendChild(btn);
      });

      const total = appState.fcList.length;
      if (total === 0) return;

      const card = appState.fcList[appState.fcIdx];
      const cMeta = COURSES[card.course];
      const card3d = document.getElementById('flashcard-3d');

      card3d.classList.toggle('rotate-y-180', appState.fcFlipped);
      document.getElementById('fc-counter').textContent = `Kart ${appState.fcIdx + 1} / ${total}`;

      const cTag = document.getElementById('fc-course-tag');
      cTag.textContent = card.course;
      cTag.className = `text-xs font-extrabold px-3 py-1 rounded-full ${cMeta.badgeClass}`;
      document.getElementById('fc-source-tag').textContent = card.source;

      document.getElementById('fc-front-question').textContent = card.q;
      const frontOpts = document.getElementById('fc-front-options');
      frontOpts.innerHTML = '';
      card.options.forEach((opt, i) => {
        const pill = document.createElement('div');
        pill.className =
          'text-xs font-medium text-slate-600 dark:text-slate-300 bg-slate-100/90 dark:bg-slatebg-900/80 border border-slate-200/70 dark:border-slate-800 rounded-xl px-3 py-2 truncate';
        pill.textContent = `${LETTERS[i]}) ${opt}`;
        frontOpts.appendChild(pill);
      });

      document.getElementById('fc-back-answer').textContent = `${LETTERS[card.correct]}) ${card.options[card.correct]}`;
      document.getElementById('fc-back-hint').textContent = card.hint;

      const statusBadge = document.getElementById('fc-badge-status');
      if (userState.mistakes.includes(card.id)) {
        statusBadge.textContent = '★ Tekrar Listesinde';
        statusBadge.className = 'text-xs font-extrabold px-2.5 py-1 rounded-full bg-rose-500/15 text-rose-500';
      } else if (userState.solved[card.id] === 'correct') {
        statusBadge.textContent = '✓ Biliniyor';
        statusBadge.className = 'text-xs font-extrabold px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-500';
      } else {
        statusBadge.textContent = 'Yeni Kart';
        statusBadge.className = 'text-xs font-bold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slatebg-800 text-slate-500';
      }
    }

    // =========================================================================
    // 12. YANLIŞLARIM (MISTAKES & BOOKMARKS)
    // =========================================================================
    function renderMistakes() {
      const listEl = document.getElementById('mistakes-cards-list');
      const emptyEl = document.getElementById('mistakes-empty-box');
      const startBtn = document.getElementById('btn-mistakes-quiz');

      const mistakeQs = QUESTIONS.filter((q) => userState.mistakes.includes(q.id));
      startBtn.disabled = mistakeQs.length === 0;
      listEl.innerHTML = '';

      if (mistakeQs.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      emptyEl.classList.add('hidden');

      mistakeQs.forEach((q, idx) => {
        const cMeta = COURSES[q.course];
        const card = document.createElement('div');
        card.className =
          'glass-panel bg-white/85 dark:bg-slatebg-850/85 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3';

        card.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-extrabold px-2.5 py-0.5 rounded-lg bg-rose-500/15 text-rose-500">#${idx + 1}</span>
              <span class="text-xs font-extrabold px-2.5 py-0.5 rounded-full ${cMeta.badgeClass}">${q.course}</span>
              <span class="text-xs font-semibold text-slate-400">${q.source}</span>
            </div>
            <button
              type="button"
              data-id="${q.id}"
              class="btn-remove-mistake text-xs font-bold text-slate-400 hover:text-emerald-500 transition-colors cursor-pointer"
            >
              ✓ Öğrendim, Listeden Çıkar
            </button>
          </div>
          <p class="font-display text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-relaxed">${q.q}</p>
          <div class="rounded-xl p-3.5 bg-emerald-500/10 border border-emerald-500/25 space-y-1">
            <p class="text-xs sm:text-sm font-extrabold text-emerald-600 dark:text-emerald-300">
              Doğru Cevap: ${LETTERS[q.correct]}) ${q.options[q.correct]}
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">${q.hint}</p>
          </div>
        `;
        listEl.appendChild(card);
      });

      listEl.querySelectorAll('.btn-remove-mistake').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = Number(btn.dataset.id);
          removeMistake(id);
          userState.solved[id] = 'correct';
          saveUserState();
          renderHeader();
          renderMistakes();
          showToast('Soru öğrenildi olarak işaretlendi ve listeden çıkarıldı.');
        });
      });
    }

    // =========================================================================
    // 13. EVENT BINDINGS & KEYBOARD SHORTCUTS
    // =========================================================================
    function bindAllEvents() {
      // Navigation triggers
      document.querySelectorAll('.nav-link, .nav-trigger').forEach((el) => {
        el.addEventListener('click', () => {
          const target = el.dataset.nav;
          if (target) {
            if (target === 'quiz' && appState.quizMistakesOnly) {
              initQuiz(false, false);
            }
            navigateTo(target);
          }
        });
      });

      // Hero Quick Start Quiz
      document.getElementById('hero-start-quiz').addEventListener('click', () => {
        appState.quizFilter = 'Tümü';
        initQuiz(false, true);
        navigateTo('quiz');
      });

      // Exam Countdown Input
      document.getElementById('exam-date-input').addEventListener('change', (e) => {
        userState.examDate = e.target.value;
        saveUserState();
        updateCountdown();
        showToast('Hedef sınav tarihi güncellendi.');
      });

      // Theme Toggle
      document.getElementById('btn-theme-toggle').addEventListener('click', toggleTheme);

      // Download HTML for GitHub Pages
      document.getElementById('btn-download-html').addEventListener('click', downloadPortalHTML);
      document.getElementById('btn-download-html-secondary').addEventListener('click', downloadPortalHTML);

      // Quiz Controls
      document.getElementById('btn-quiz-shuffle').addEventListener('click', () => {
        appState.quizList = shuffle(appState.quizList);
        appState.quizIdx = 0;
        appState.quizAnswers = {};
        appState.quizFinished = false;
        renderQuiz();
        showToast('Sorular rastgele karıştırıldı.');
      });

      document.getElementById('btn-quiz-restart').addEventListener('click', () => {
        initQuiz(appState.quizMistakesOnly, false);
        renderQuiz();
        showToast('Test baştan başlatıldı.');
      });

      document.getElementById('btn-star-question').addEventListener('click', () => {
        const q = appState.quizList[appState.quizIdx];
        if (!q) return;
        if (userState.mistakes.includes(q.id)) {
          removeMistake(q.id);
          showToast('Zorlandıklarım listesinden çıkarıldı.');
        } else {
          addMistake(q.id);
          showToast('Zorlandıklarım listesine eklendi.');
        }
        renderHeader();
        renderQuiz();
      });

      document.getElementById('btn-quiz-prev').addEventListener('click', () => {
        if (appState.quizIdx > 0) {
          appState.quizIdx--;
          renderQuiz();
        }
      });

      document.getElementById('btn-quiz-next').addEventListener('click', () => {
        if (appState.quizIdx < appState.quizList.length - 1) {
          appState.quizIdx++;
        } else {
          appState.quizFinished = true;
        }
        renderQuiz();
      });

      document.getElementById('btn-summary-again').addEventListener('click', () => {
        initQuiz(appState.quizMistakesOnly, true);
        renderQuiz();
      });

      document.getElementById('btn-summary-goto-mistakes').addEventListener('click', () => {
        navigateTo('mistakes');
      });

      // Exam Simulation Controls
      document.getElementById('btn-exam-start').addEventListener('click', startExamSimulation);

      document.getElementById('btn-exam-flag').addEventListener('click', () => {
        const idx = appState.examIdx;
        appState.examFlags[idx] = !appState.examFlags[idx];
        renderExamRunner();
      });

      document.getElementById('btn-exam-clear-choice').addEventListener('click', () => {
        delete appState.examAnswers[appState.examIdx];
        renderExamRunner();
      });

      document.getElementById('btn-exam-prev').addEventListener('click', () => {
        if (appState.examIdx > 0) {
          appState.examIdx--;
          renderExamRunner();
        }
      });

      document.getElementById('btn-exam-next').addEventListener('click', () => {
        if (appState.examIdx < appState.examQuestions.length - 1) {
          appState.examIdx++;
        } else {
          appState.examIdx = 0;
        }
        renderExamRunner();
      });

      document.getElementById('btn-exam-finish').addEventListener('click', () => finishExamSimulation(false));

      document.getElementById('btn-exam-new').addEventListener('click', () => {
        appState.examStatus = 'lobby';
        renderExamView();
      });

      document.getElementById('btn-exam-goto-mistakes').addEventListener('click', () => {
        navigateTo('mistakes');
      });

      // Notes Search
      document.getElementById('notes-search-input').addEventListener('input', (e) => {
        appState.notesSearch = e.target.value;
        renderNotes();
      });

      // Flashcards Controls
      const fc3d = document.getElementById('flashcard-3d');
      fc3d.addEventListener('click', () => {
        appState.fcFlipped = !appState.fcFlipped;
        renderFlashcards();
      });

      document.getElementById('btn-fc-shuffle').addEventListener('click', () => {
        appState.fcList = shuffle(appState.fcList);
        appState.fcIdx = 0;
        appState.fcFlipped = false;
        renderFlashcards();
        showToast('Kartlar karıştırıldı.');
      });

      document.getElementById('btn-fc-prev').addEventListener('click', () => {
        appState.fcIdx = (appState.fcIdx - 1 + appState.fcList.length) % appState.fcList.length;
        appState.fcFlipped = false;
        renderFlashcards();
      });

      document.getElementById('btn-fc-next').addEventListener('click', () => {
        appState.fcIdx = (appState.fcIdx + 1) % appState.fcList.length;
        appState.fcFlipped = false;
        renderFlashcards();
      });

      document.getElementById('btn-fc-learned').addEventListener('click', () => {
        const card = appState.fcList[appState.fcIdx];
        if (!card) return;
        userState.solved[card.id] = 'correct';
        removeMistake(card.id);
        saveUserState();
        renderHeader();
        showToast('Kart öğrenildi olarak işaretlendi.');
        appState.fcIdx = (appState.fcIdx + 1) % appState.fcList.length;
        appState.fcFlipped = false;
        renderFlashcards();
      });

      document.getElementById('btn-fc-repeat').addEventListener('click', () => {
        const card = appState.fcList[appState.fcIdx];
        if (!card) return;
        addMistake(card.id);
        if (!userState.solved[card.id]) {
          userState.solved[card.id] = 'wrong';
          saveUserState();
        }
        renderHeader();
        showToast('Tekrar listesine eklendi.');
        appState.fcIdx = (appState.fcIdx + 1) % appState.fcList.length;
        appState.fcFlipped = false;
        renderFlashcards();
      });

      // Mistakes Mini Test Start
      document.getElementById('btn-mistakes-quiz').addEventListener('click', () => {
        appState.quizFilter = 'Tümü';
        initQuiz(true, true);
        navigateTo('quiz');
        showToast('Yanlışlarınızdan oluşan mini test başlatıldı!');
      });

      // Reset Modal
      const modal = document.getElementById('reset-modal');
      document.getElementById('btn-reset-open').addEventListener('click', () => modal.classList.remove('hidden'));
      document.getElementById('btn-reset-cancel').addEventListener('click', () => modal.classList.add('hidden'));
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      });
      document.getElementById('btn-reset-confirm').addEventListener('click', () => {
        userState = {
          theme: userState.theme,
          solved: {},
          mistakes: [],
          streak: 0,
          examDate: userState.examDate,
        };
        saveUserState();
        initQuiz(false, false);
        initFlashcards(false);
        modal.classList.add('hidden');
        renderHeader();
        renderHome();
        showToast('Tüm ilerleme kayıtları sıfırlandı.');
      });

      // Keyboard Shortcuts
      document.addEventListener('keydown', (e) => {
        if (!document.getElementById('reset-modal').classList.contains('hidden')) return;
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

        if (appState.activePage === 'quiz' && !appState.quizFinished && appState.quizList.length > 0) {
          const k = e.key.toLowerCase();
          const map = { a: 0, b: 1, c: 2, d: 3, e: 4, '1': 0, '2': 1, '3': 2, '4': 3, '5': 4 };
          if (k in map) {
            e.preventDefault();
            handleQuizAnswer(map[k]);
          } else if (e.key === 'Enter' || e.key === 'ArrowRight') {
            e.preventDefault();
            if (appState.quizIdx < appState.quizList.length - 1) appState.quizIdx++;
            else appState.quizFinished = true;
            renderQuiz();
          } else if (e.key === 'ArrowLeft' && appState.quizIdx > 0) {
            e.preventDefault();
            appState.quizIdx--;
            renderQuiz();
          }
        } else if (appState.activePage === 'flashcards') {
          if (e.key === ' ') {
            e.preventDefault();
            appState.fcFlipped = !appState.fcFlipped;
            renderFlashcards();
          } else if (e.key === 'ArrowRight') {
            appState.fcIdx = (appState.fcIdx + 1) % appState.fcList.length;
            appState.fcFlipped = false;
            renderFlashcards();
          } else if (e.key === 'ArrowLeft') {
            appState.fcIdx = (appState.fcIdx - 1 + appState.fcList.length) % appState.fcList.length;
            appState.fcFlipped = false;
            renderFlashcards();
          }
        }
      });
    }

    // =========================================================================
    // 14. INITIALIZE PORTAL
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      applyTheme(userState.theme);
      initQuiz(false, true);
      initFlashcards(false);
      bindAllEvents();
      setInterval(updateCountdown, 60000);
      navigateTo('home');
    });
  </script>

</body></html>
