      <div class="glass-panel bg-white/80 dark:bg-slatebg-850/80 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="font-display text-sm font-extrabold text-slate-900 dark:text-white">
              GitHub Pages'te Yayınlamaya Hazır Tek Dosya Mimari
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Sağ üstteki <strong>"Çevrimdışı İndir (index.html)"</strong> butonuna tıklayarak bu portalı tek dosya olarak bilgisayarınıza indirin, GitHub'da yeni bir repo açıp dosyayı yükleyin ve <em>Settings → Pages</em> bölümünden canlı linkinizi alın.
            </p>
          </div>
        </div>
        <button type="button" id="btn-download-html-secondary" class="shrink-0 px-4 py-2.5 rounded-xl text-xs font-extrabold bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:opacity-90 transition-opacity cursor-pointer">
          index.html İndir
        </button>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- PAGE 2: TEST ÇÖZ MODU                                                 -->
    <!-- ===================================================================== -->
    <section id="page-quiz" class="space-y-5 animate-fade-in hidden">
      <!-- Filter & Session Header -->
      <div class="glass-panel bg-white/85 dark:bg-slatebg-850/85 rounded-2xl p-4 sm:p-5 border border-slate-200/80 dark:border-slate-800 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <!-- Course Filter Pills -->
          <div id="quiz-course-filters" class="flex flex-wrap items-center gap-2"><button type="button" class="px-3.5 py-2 rounded-xl text-xs font-extrabold bg-sky-600 text-white shadow-sm cursor-pointer">Tümü (90)</button><button type="button" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer">Havacılık Hukuku (30)</button><button type="button" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer">Müşteri İlişkileri Yönetimi (30)</button><button type="button" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer">Lojistik Yönetimi (30)</button></div>

          <div class="flex items-center gap-2">
            <button id="btn-quiz-shuffle" type="button" class="inline-flex items-center gap-1.5 text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slatebg-800 hover:border-sky-500/50 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 cursor-pointer">
              <svg class="w-3.5 h-3.5 text-sky-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              <span>Soruları Karıştır</span>
            </button>

            <button id="btn-quiz-restart" type="button" class="text-xs font-bold px-3.5 py-2 rounded-xl bg-sky-500/15 hover:bg-sky-500/25 text-sky-600 dark:text-sky-300 border border-sky-500/25 cursor-pointer">
              Baştan Başla
            </button>
          </div>
        </div>

        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs font-bold">
            <span id="quiz-mode-label" class="text-xs font-extrabold text-sky-600 dark:text-sky-400">Tümü — Alıştırma Testi</span>
            <span id="quiz-counter" class="text-slate-700 dark:text-slate-200">Soru 1 / 90</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-200/80 dark:bg-slatebg-950 overflow-hidden">
            <div id="quiz-progress-fill" class="h-full bg-gradient-to-r from-sky-500 via-indigo-500 to-amber-500 rounded-full transition-all duration-300" style="width: 0%;"></div>
          </div>
        </div>
      </div>

      <!-- Active Question Card -->
      <div id="quiz-card" class="glass-panel bg-white/90 dark:bg-slatebg-850/90 rounded-3xl p-5 sm:p-8 border border-slate-200/80 dark:border-slate-800 shadow-lg space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex flex-wrap items-center gap-2">
            <span id="quiz-course-tag" class="text-xs font-extrabold px-3 py-1 rounded-full bg-sky-500/15 text-sky-600 dark:text-sky-300 border border-sky-500/25">Havacılık Hukuku</span>
            <span id="quiz-source-tag" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slatebg-800 text-slate-500 dark:text-slate-400 border border-slate-200/70 dark:border-slate-700">1. Hafta</span>
          </div>

          <button id="btn-star-question" type="button" class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slatebg-800 text-slate-600 dark:text-slate-300 cursor-pointer">☆ Yıldızla</button>
        </div>

        <h2 id="quiz-question-text" class="font-display text-lg sm:text-xl font-bold text-slate-900 dark:text-white leading-relaxed">Aşağıdakilerden hangisi Özel Hukukun alt hukuk dallarından birisi değildir?</h2>

        <div id="quiz-options-list" class="space-y-3"><button type="button" class="w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-start gap-3.5 bg-slate-50/80 dark:bg-slatebg-900/70 border-slate-200/90 dark:border-slate-800 hover:border-sky-500/60 hover:bg-sky-500/5 text-slate-800 dark:text-slate-100 cursor-pointer">
          <span class="shrink-0 w-7 h-7 rounded-lg border text-xs font-extrabold flex items-center justify-center mt-0.5 bg-white dark:bg-slatebg-800 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-700">
            A
          </span>
          <span class="text-sm sm:text-base font-medium leading-snug flex-1">Medeni Hukuk</span>
        </button><button type="button" class="w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-start gap-3.5 bg-slate-50/80 dark:bg-slatebg-900/70 border-slate-200/90 dark:border-slate-800 hover:border-sky-500/60 hover:bg-sky-500/5 text-slate-800 dark:text-slate-100 cursor-pointer">
          <span class="shrink-0 w-7 h-7 rounded-lg border text-xs font-extrabold flex items-center justify-center mt-0.5 bg-white dark:bg-slatebg-800 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-700">
            B
          </span>
          <span class="text-sm sm:text-base font-medium leading-snug flex-1">Borçlar Hukuku</span>
        </button><button type="button" class="w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-start gap-3.5 bg-slate-50/80 dark:bg-slatebg-900/70 border-slate-200/90 dark:border-slate-800 hover:border-sky-500/60 hover:bg-sky-500/5 text-slate-800 dark:text-slate-100 cursor-pointer">
          <span class="shrink-0 w-7 h-7 rounded-lg border text-xs font-extrabold flex items-center justify-center mt-0.5 bg-white dark:bg-slatebg-800 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-700">
            C
          </span>
          <span class="text-sm sm:text-base font-medium leading-snug flex-1">Ticaret Hukuku</span>
        </button><button type="button" class="w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-start gap-3.5 bg-slate-50/80 dark:bg-slatebg-900/70 border-slate-200/90 dark:border-slate-800 hover:border-sky-500/60 hover:bg-sky-500/5 text-slate-800 dark:text-slate-100 cursor-pointer">
          <span class="shrink-0 w-7 h-7 rounded-lg border text-xs font-extrabold flex items-center justify-center mt-0.5 bg-white dark:bg-slatebg-800 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-700">
            D
          </span>
          <span class="text-sm sm:text-base font-medium leading-snug flex-1">Vergi Hukuku</span>
        </button><button type="button" class="w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-start gap-3.5 bg-slate-50/80 dark:bg-slatebg-900/70 border-slate-200/90 dark:border-slate-800 hover:border-sky-500/60 hover:bg-sky-500/5 text-slate-800 dark:text-slate-100 cursor-pointer">
          <span class="shrink-0 w-7 h-7 rounded-lg border text-xs font-extrabold flex items-center justify-center mt-0.5 bg-white dark:bg-slatebg-800 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-700">
            E
          </span>
          <span class="text-sm sm:text-base font-medium leading-snug flex-1">Devletler Özel Hukuku</span>
        </button></div>

        <!-- Instant Feedback -->
        <div id="quiz-feedback-box" class="hidden rounded-2xl p-4 sm:p-5 border animate-fade-in">
          <div class="flex items-start gap-3">
            <div id="quiz-feedback-icon" class="shrink-0 mt-0.5"></div>
            <div class="space-y-1 flex-1">
              <p id="quiz-feedback-title" class="text-sm font-extrabold"></p>
              <p id="quiz-feedback-hint" class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed"></p>
            </div>
          </div>
        </div>

        <!-- Footer Controls -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 border-t border-slate-200/70 dark:border-slate-800">
          <div class="hidden sm:flex items-center gap-2 text-xs text-slate-400">
            <kbd class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slatebg-800 border border-slate-200 dark:border-slate-700 font-mono text-slate-600 dark:text-slate-300">A-E</kbd>
            <span>veya</span>
            <kbd class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slatebg-800 border border-slate-200 dark:border-slate-700 font-mono text-slate-600 dark:text-slate-300">1-5</kbd>
            <span>şıkkı seç •</span>
            <kbd class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slatebg-800 border border-slate-200 dark:border-slate-700 font-mono text-slate-600 dark:text-slate-300">Enter / →</kbd>
            <span>sonraki</span>
          </div>

          <div class="flex items-center gap-2.5 sm:ml-auto">
            <button id="btn-quiz-prev" type="button" class="px-4 py-2.5 rounded-xl text-sm font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slatebg-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" disabled="">
              ← Önceki
            </button>
            <button id="btn-quiz-next" type="button" class="px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 shadow-md shadow-sky-500/20 transition-all cursor-pointer inline-flex items-center gap-2">
              <span id="btn-quiz-next-text">Sonraki Soru</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Quiz Summary -->
      <div id="quiz-summary" class="hidden glass-panel bg-white/90 dark:bg-slatebg-850/90 rounded-3xl p-6 sm:p-10 border border-slate-200/80 dark:border-slate-800 shadow-lg text-center space-y-6 animate-fade-in">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center">
          <svg class="w-9 h-9 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="space-y-1">
          <h3 class="font-display text-2xl font-extrabold text-slate-900 dark:text-white">Test Tamamlandı!</h3>
          <p id="summary-desc" class="text-sm text-slate-500 dark:text-slate-400"></p>
        </div>
        <div class="grid grid-cols-3 gap-3 max-w-lg mx-auto">
          <div class="rounded-2xl p-4 bg-slate-100/80 dark:bg-slatebg-900 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs font-semibold text-slate-500">Doğru</div>
            <div id="summary-correct" class="text-2xl font-extrabold text-emerald-500 mt-1">0</div>
          </div>
          <div class="rounded-2xl p-4 bg-slate-100/80 dark:bg-slatebg-900 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs font-semibold text-slate-500">Yanlış</div>
            <div id="summary-wrong" class="text-2xl font-extrabold text-rose-500 mt-1">0</div>
          </div>
          <div class="rounded-2xl p-4 bg-slate-100/80 dark:bg-slatebg-900 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs font-semibold text-slate-500">Başarı</div>
            <div id="summary-rate" class="text-2xl font-extrabold text-sky-500 mt-1">%0</div>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button id="btn-summary-again" type="button" class="px-5 py-3 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-sky-500 to-indigo-600 cursor-pointer">
            Tekrar Çöz
          </button>
          <button id="btn-summary-goto-mistakes" type="button" class="px-5 py-3 rounded-xl text-sm font-bold text-rose-500 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/25 cursor-pointer">
            Yanlışlarıma Git
          </button>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- PAGE 3: SINAV SİMÜLASYONU (20 SORU / 25 DAKİKA GERÇEK SINAV MODU)     -->
    <!-- ===================================================================== -->
    <section id="page-exam" class="space-y-6 animate-fade-in hidden">
      <!-- 3A. EXAM LOBBY -->
      <div id="exam-lobby" class="glass-panel bg-white/90 dark:bg-slatebg-850/90 rounded-3xl p-6 sm:p-10 border border-slate-200/80 dark:border-slate-800 shadow-lg max-w-3xl mx-auto space-y-6">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/15 border border-amber-500/30 text-amber-500 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h2 class="font-display text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">
              Gerçek Sınav Simülasyonu
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
              20 Soru • 25 Dakika Süre • Anında Cevap Gösterilmez • Sınav Sonu Detaylı Karne
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
          <div class="p-4 rounded-2xl bg-slate-100/80 dark:bg-slatebg-900 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs font-bold text-slate-500 dark:text-slate-400">Soru Sayısı</div>
            <div class="font-display text-xl font-extrabold text-slate-900 dark:text-white mt-1">20 Soru</div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-100/80 dark:bg-slatebg-900 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs font-bold text-slate-500 dark:text-slate-400">Sınav Süresi</div>
            <div class="font-display text-xl font-extrabold text-amber-500 mt-1">25:00 Dk</div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-100/80 dark:bg-slatebg-900 border border-slate-200/70 dark:border-slate-800">
            <div class="text-xs font-bold text-slate-500 dark:text-slate-400">Değerlendirme</div>
            <div class="font-display text-xl font-extrabold text-emerald-500 mt-1">100 Puan</div>
          </div>
        </div>

        <div class="space-y-2.5">
          <label class="block text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Sınav Kapsamını Seçin
          </label>
          <div id="exam-scope-options" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"><button type="button" class="text-left p-4 rounded-2xl border-2 border-amber-500 bg-amber-500/10 transition-all cursor-pointer">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white">Karma Deneme Sınavı (3 Ders)</div>
          <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">Havacılık Hukuku + MİY + Lojistik</div>
        </button><button type="button" class="text-left p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slatebg-900/70 hover:border-amber-500/40 transition-all cursor-pointer">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white">Havacılık Hukuku Sınavı</div>
          <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">20 Soruluk Branş Denemesi</div>
        </button><button type="button" class="text-left p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slatebg-900/70 hover:border-amber-500/40 transition-all cursor-pointer">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white">Müşteri İlişkileri Yönetimi Sınavı</div>
          <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">20 Soruluk Branş Denemesi</div>
        </button><button type="button" class="text-left p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slatebg-900/70 hover:border-amber-500/40 transition-all cursor-pointer">
          <div class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white">Lojistik Yönetimi Sınavı</div>
          <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">20 Soruluk Branş Denemesi</div>
        </button></div>
        </div>

        <div class="pt-2">
          <button id="btn-exam-start" type="button" class="w-full py-3.5 px-6 rounded-2xl text-sm sm:text-base font-extrabold text-white bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 hover:opacity-95 shadow-lg shadow-amber-500/20 transition-all cursor-pointer flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.3" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Sınavı Başlat</span>
          </button>
        </div>
      </div>

      <!-- 3B. ACTIVE EXAM RUNNER -->
      <div id="exam-runner" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- Left/Main Question Panel -->
        <div class="lg:col-span-8 glass-panel bg-white/90 dark:bg-slatebg-850/90 rounded-3xl p-5 sm:p-8 border border-slate-200/80 dark:border-slate-800 shadow-lg space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-slate-200/70 dark:border-slate-800">
            <div class="flex items-center gap-2">
              <span id="exam-q-num" class="text-xs font-extrabold px-3 py-1 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/25">
                Soru 1 / 20
              </span>
              <span id="exam-q-course" class="text-xs font-bold px-3 py-1 rounded-full"></span>
            </div>

            <button id="btn-exam-flag" type="button" class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-xl border transition-all cursor-pointer"></button>
          </div>

          <h3 id="exam-q-text" class="font-display text-lg sm:text-xl font-bold text-slate-900 dark:text-white leading-relaxed"></h3>

          <div id="exam-options-list" class="space-y-3"></div>

