    <!-- PAGE 6: YANLIŞLARIM & ZORLANDIKLARIM                                  -->
    <!-- ===================================================================== -->
    <section id="page-mistakes" class="space-y-5 animate-fade-in hidden">
      <div class="glass-panel bg-white/85 dark:bg-slatebg-850/85 rounded-3xl p-5 sm:p-7 border border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-display text-xl font-extrabold text-slate-900 dark:text-white">
            Yanlışlarım &amp; Zorlandığım Sorular
          </h2>
          <p id="mistakes-desc" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Yanlış cevapladığınız veya yıldızladığınız sorular burada toplanır. Mini testte doğru çözdüğünüz sorular otomatik olarak listeden düşer.
          </p>
        </div>

        <button id="btn-mistakes-quiz" type="button" class="px-5 py-3 rounded-2xl text-sm font-extrabold text-white bg-gradient-to-r from-rose-500 to-amber-500 hover:opacity-95 shadow-md shadow-rose-500/20 transition-all cursor-pointer inline-flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed shrink-0" disabled="">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.3" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Yanlışlarımdan Mini Test Başlat</span>
        </button>
      </div>

      <div id="mistakes-cards-list" class="space-y-3"></div>

      <div id="mistakes-empty-box" class="glass-panel bg-white/85 dark:bg-slatebg-850/85 rounded-3xl p-10 border border-slate-200/80 dark:border-slate-800 text-center space-y-3">
